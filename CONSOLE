  });

  /* ============ UTIL ============ */
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function attr(s){ return esc(s); }
  function emptyRow(colspan,msg){ return '<tr class="empty-row"><td colspan="'+colspan+'">'+msg+'</td></tr>'; }
  function todayISO(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }

  /* ============ RENDER ALL ============ */
  function renderAll(){
    renderOverview();
    renderRoster();
    renderDaily();
    renderKpi();
    renderViolationForm();
    renderViolationTable();
    renderFunded();
    renderLive();
    renderInvestors();
    renderRemittance();
    renderDividend();
    renderExposureForm();
    renderExposureGroups();
    renderWorkflow();
    renderReference();
    renderSettings();
    document.getElementById('flagViol').className = 'flag'+(violationLog.some(function(v){return v.level>=3;})?' show':'');
    document.getElementById('flagFunded').className = 'flag'+(fundedAccounts.some(function(a){return fundedStatus(a).cls==='bad';})?' show':'');
    document.getElementById('flagLive').className = 'flag'+(liveAccounts.some(function(a){return liveStatus(a).cls==='bad';})?' show':'');
    document.getElementById('flagInvestors').className = 'flag'+(investors.some(function(i){ var ls=lockupStatus(i); return ls.cls==='warn' && ls.daysLeft<=14; })?' show':'');
    var anyOverdue = fundedAccounts.some(function(a){
      var earn = fundedEarnings(a); var owed = amountOwed(earn); if(owed<=0) return false;
      var rec = getRemitRecord('funded', a.id); var due = dueDateFor('funded', rec);
      var st = remittanceStatus(rec, due, owed); return st && st.cls==='bad';
    }) || liveAccounts.some(function(a){
      var earn = liveEarnings(a); var owed = amountOwed(earn); if(owed<=0) return false;
      var rec = getRemitRecord('live', a.id); var due = dueDateFor('live', rec);
      var st = remittanceStatus(rec, due, owed); return st && st.cls==='bad';
    });
    document.getElementById('flagRemit').className = 'flag'+(anyOverdue?' show':'');
  }

  // Test hooks only — lets an automated check re-trigger a load and inspect current settings
  // without needing a real page reload. No effect on normal use.
  if(typeof window !== 'undefined'){
    window.__e1_reload = loadAll;
    window.__e1_settings = function(){ return settings; };
  }

  loadAll();
})();
</script>
</body>
