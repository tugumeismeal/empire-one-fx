<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Empire One FX — Ops Console</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
  :root{
    --bs-body-font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, "SF Mono", Consolas, monospace;
    --e1-bg:#0B141C;
    --e1-panel:#101E29;
    --e1-panel-2:#0D1922;
    --e1-line:#1E3240;
    --e1-accent:#3E8FA8;
    --e1-accent-soft:#1C3A44;
    --e1-gold:#C9A227;
    --e1-gold-soft:#241C09;
    --e1-ink-dim:#8FA3AF;
    --e1-ink-faint:#5C707B;
  }
  body{
    background:var(--e1-bg);
    color:#E7EEF2;
    font-family:var(--bs-body-font-family);
  }
  .mono{ font-family:var(--mono); }
  h1,h2,h3,h4,h5,h6, .navbar-brand{ letter-spacing:-0.01em; }

  /* ---------- Sidebar ---------- */
  #sidebar{
    width:250px;
    min-width:250px;
    background:var(--e1-panel-2);
    border-right:1px solid var(--e1-line);
    min-height:100vh;
    position:sticky;
    top:0;
    align-self:flex-start;
  }
  #sidebar .brand{
    padding:20px 18px 16px;
    border-bottom:1px solid var(--e1-line);
  }
  #sidebar .brand .mark{
    font-family:var(--mono); font-size:10px; letter-spacing:.18em;
    color:var(--e1-gold); text-transform:uppercase;
  }
  #sidebar .brand h1{ font-size:19px; font-weight:800; margin:5px 0 2px; }
  #sidebar .brand .sub{ font-size:11.5px; color:var(--e1-ink-dim); }
  #sidebar .navgroup-label{
    font-family:var(--mono); font-size:10px; letter-spacing:.12em; text-transform:uppercase;
    color:var(--e1-ink-faint); padding:16px 18px 6px;
  }
  #sidebar .nav-link{
    color:var(--e1-ink-dim);
    font-size:13.5px;
    padding:9px 18px;
    border-radius:0;
    display:flex; align-items:center; gap:9px;
  }
  #sidebar .nav-link .dot{ width:6px; height:6px; border-radius:50%; background:var(--e1-ink-faint); flex:0 0 auto; }
  #sidebar .nav-link:hover{ background:#132430; color:#fff; }
  #sidebar .nav-link.active{ background:var(--e1-accent-soft); color:#fff; font-weight:600; }
  #sidebar .nav-link.active .dot{ background:var(--e1-accent); }
  #sidebar .nav-link .flag{
    margin-left:auto; font-family:var(--mono); font-size:10px;
    background:#301112; color:#e07777; padding:1px 7px; border-radius:20px; display:none;
  }
  #sidebar .nav-link .flag.show{ display:inline-block; }
  #sidebar .sidebar-foot{
    padding:14px 18px; border-top:1px solid var(--e1-line);
    font-size:10.5px; color:var(--e1-ink-faint); font-family:var(--mono);
  }

  /* ---------- Main ---------- */
  main{ min-width:0; }
  .view{ display:none; }
  .view.active{ display:block; animation:e1fade .2s ease; }
  @keyframes e1fade{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }
  .eyebrow{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; color:var(--e1-gold); text-transform:uppercase; }

  .card{ background:var(--e1-panel); border:1px solid var(--e1-line); }
  .card.stat-card{ border-left-width:3px; border-left-color:var(--e1-ink-faint); }
  .card.stat-card.ok{ border-left-color:#3FA35A; }
  .card.stat-card.warn{ border-left-color:#D99A2B; }
  .card.stat-card.bad{ border-left-color:#D64545; }
  .stat-card .stat-label{ font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--e1-ink-dim); }
  .stat-card .stat-value{ font-family:var(--mono); font-size:24px; font-weight:700; }
  .stat-card .stat-sub{ font-size:11px; color:var(--e1-ink-faint); }

  .table{ --bs-table-bg:transparent; font-size:13px; vertical-align:middle; }
  .table thead th{
    font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--e1-ink-faint);
    border-bottom-color:var(--e1-line); white-space:nowrap; font-weight:600;
  }
  .table td{ border-color:var(--e1-line); }
  .table-hover>tbody>tr:hover>*{ background-color:#0F1D27; }
  .form-control, .form-select{
    background:#0A151D; border-color:var(--e1-line); color:#E7EEF2; font-size:13px;
  }
  .form-control:focus, .form-select:focus{
    background:#0A151D; color:#fff; border-color:var(--e1-accent); box-shadow:0 0 0 .2rem rgba(62,143,168,.25);
  }
  .form-control.mono, input[type=number].form-control{ font-family:var(--mono); }
  .tbl-num{ width:100px; }
  .tbl-input{ min-width:120px; }
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }
  input[type=number]{ -moz-appearance:textfield; }

  .tier-pill{ font-size:11px; font-weight:600; padding:2px 9px; border-radius:5px; }
  .tier-Probationary{ background:#241a09; color:#d99a2b; }
  .tier-Standard{ background:#0d2430; color:#5fb9d6; }
  .tier-Senior{ background:#132a1c; color:#4fbf74; }
  .tier-Lead{ background:var(--e1-gold-soft); color:var(--e1-gold); }

  .btn-e1{ background:var(--e1-accent); border-color:var(--e1-accent); color:#03181e; font-weight:700; }
  .btn-e1:hover{ background:#4ea0bb; border-color:#4ea0bb; color:#03181e; }
  .btn-outline-e1{ border-color:var(--e1-line); color:var(--e1-ink-dim); }
  .btn-outline-e1:hover{ border-color:var(--e1-accent); color:#fff; background:transparent; }
  .btn-del{ width:28px; height:28px; padding:0; line-height:1; border-color:var(--e1-line); color:var(--e1-ink-faint); }
  .btn-del:hover{ border-color:#D64545; color:#D64545; }

  .payout-value{ font-family:var(--mono); font-weight:700; font-size:14px; }
  .payout-value.pos{ color:#5fd583; }
  .payout-value.zero{ color:var(--e1-ink-faint); }

  .progress{ height:7px; background:#0A151D; border:1px solid var(--e1-line); width:100px; }

  .empty-row td{ text-align:center; color:var(--e1-ink-faint); padding:22px 10px; }

  .note{ font-size:11.5px; color:var(--e1-ink-faint); }

  /* Dashboard KPI Cards */
  .kpi-card { 
    background: linear-gradient(135deg, var(--e1-panel) 0%, var(--e1-panel-2) 100%);
    border:1px solid var(--e1-line); 
    border-radius:12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }
  .kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .kpi-card .kpi-icon {
    width: 48px; height: 48px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    margin-bottom: 12px;
  }
  .kpi-card .kpi-label { 
    font-size: 11px; 
    text-transform: uppercase; 
    letter-spacing: 0.08em; 
    color: var(--e1-ink-dim);
    margin-bottom: 6px;
  }
  .kpi-card .kpi-value { 
    font-family: var(--mono); 
    font-size: 28px; 
    font-weight: 700;
    line-height: 1.2;
  }
  .kpi-card .kpi-sub { 
    font-size: 11px; 
    color: var(--e1-ink-faint); 
    margin-top: 4px;
  }
  .kpi-icon.blue { background: rgba(62,143,168,0.15); color: #3E8FA8; }
  .kpi-icon.green { background: rgba(95,213,131,0.15); color: #5FD583; }
  .kpi-icon.gold { background: rgba(201,162,39,0.15); color: #C9A227; }
  .kpi-icon.red { background: rgba(214,69,69,0.15); color: #D64545; }
  .kpi-icon.purple { background: rgba(147,112,219,0.15); color: #9370DB; }
  
  /* Chart containers */
  .chart-container {
    position: relative;
    height: 300px;
    width: 100%;
  }
  .chart-card {
    background: var(--e1-panel);
    border: 1px solid var(--e1-line);
    border-radius: 12px;
    padding: 20px;
  }
  .chart-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 16px;
    color: #E7EEF2;
  }

  .note{ font-size:11.5px; color:var(--e1-ink-faint); }

  .modal-content{ background:var(--e1-panel); border:1px solid var(--e1-line); color:#E7EEF2; }
  .waterfall-row{
    display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px dashed var(--e1-line); font-size:13px;
  }
  .waterfall-row .k{ color:var(--e1-ink-dim); }
  .waterfall-row .v{ font-family:var(--mono); font-weight:600; }
  .waterfall-row.final{ border-bottom:none; border-top:2px solid var(--e1-accent); padding-top:14px; margin-top:6px; }
  .waterfall-row.final .k{ color:#E7EEF2; font-weight:700; font-size:14px; }
  .waterfall-row.final .v{ color:#5fd583; font-size:20px; }

  ::-webkit-scrollbar{ width:10px; height:10px; }
  ::-webkit-scrollbar-thumb{ background:#1E3240; border-radius:6px; }
  ::-webkit-scrollbar-track{ background:transparent; }

  @media (max-width: 860px){
    body{ display:block !important; }
    #sidebar{ width:100%; min-width:100%; position:relative; min-height:auto; }
  }
</style>
</head>
<body class="d-flex">

<aside id="sidebar">
  <div class="brand">
    <div class="mark">Empire One FX</div>
    <h1>Ops Console</h1>
    <div class="sub">Live monitoring &amp; enforcement board</div>
  </div>
  <nav class="nav flex-column py-2" id="navList">
    <div class="navgroup-label">Overview</div>
    <a href="#" class="nav-link" data-view="overview"><span class="dot"></span>Group Dashboard</a>

    <div class="navgroup-label">People</div>
    <a href="#" class="nav-link" data-view="roster"><span class="dot"></span>Traders &amp; Tiers</a>
    <a href="#" class="nav-link" data-view="daily"><span class="dot"></span>Daily Risk Board<span class="flag" id="flagDaily">!</span></a>
    <a href="#" class="nav-link" data-view="kpi"><span class="dot"></span>KPI Scorecard</a>
    <a href="#" class="nav-link" data-view="violations"><span class="dot"></span>Violation Log<span class="flag" id="flagViol">!</span></a>

    <div class="navgroup-label">Capital — Prop Firms</div>
    <a href="#" class="nav-link" data-view="funded"><span class="dot"></span>Funded Accounts<span class="flag" id="flagFunded">!</span></a>

    <div class="navgroup-label">Capital — Pooled Capital</div>
    <a href="#" class="nav-link" data-view="live"><span class="dot"></span>Live Accounts<span class="flag" id="flagLive">!</span></a>
    <a href="#" class="nav-link" data-view="exposure"><span class="dot"></span>Exposure Sheet<span class="flag" id="flagExp">!</span></a>

    <div class="navgroup-label">Capital — Investors</div>
    <a href="#" class="nav-link" data-view="investors"><span class="dot"></span>Investor Accounts<span class="flag" id="flagInvestors">!</span></a>

    <div class="navgroup-label">Process</div>
    <a href="#" class="nav-link" data-view="remittance"><span class="dot"></span>Remittance Tracker<span class="flag" id="flagRemit">!</span></a>
    <a href="#" class="nav-link" data-view="dividend"><span class="dot"></span>Dividend Declaration</a>
    <a href="#" class="nav-link" data-view="workflow"><span class="dot"></span>Monthly Workflow</a>
    <a href="#" class="nav-link" data-view="reference"><span class="dot"></span>Risk Quick Reference</a>

    <div class="navgroup-label">Configuration</div>
    <a href="#" class="nav-link" data-view="settings"><span class="dot"></span>Settings</a>
  </nav>
  <div class="sidebar-foot"><span id="saveState">● all changes saved locally</span></div>
</aside>

<main class="flex-grow-1 p-4" style="max-width:1240px;">

  <!-- OVERVIEW -->
  <section class="view active" id="view-overview">
    <div class="mb-3">
      <div class="eyebrow">Group Dashboard</div>
      <h2 class="mt-1 mb-1">Where things stand right now</h2>
      <p class="text-secondary small" style="max-width:640px;">Pulled live from every tab, including a real-time estimate of what traders would actually be paid on current profit — using the tier splits and waterfall from Master Plan §7.</p>
    </div>
    <div id="overviewBanner"></div>
    
    <!-- Enhanced KPI Cards Grid -->
    <div class="row g-3 mb-4" id="kpiCardGrid"></div>
    
    <!-- Charts Row -->
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="chart-card">
          <div class="chart-title"><i class="bi bi-pie-chart-fill me-2"></i>Capital Distribution</div>
          <div class="chart-container">
            <canvas id="capitalChart"></canvas>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="chart-card">
          <div class="chart-title"><i class="bi bi-bar-chart-fill me-2"></i>Exposure by Group</div>
          <div class="chart-container">
            <canvas id="exposureChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    
    <div class="row g-3 mb-4">
      <div class="col-12">
        <div class="chart-card">
          <div class="chart-title"><i class="bi bi-graph-up me-2"></i>Trader Performance Overview</div>
          <div class="chart-container" style="height: 250px;">
            <canvas id="performanceChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h3 class="h6 fw-bold mb-0">Traders currently in an alert state</h3>
          <span class="note">Daily / weekly / monthly threshold breaches — Risk Protocol §3</span>
        </div>
        <div class="table-responsive"><table class="table table-hover mb-0" id="overviewAlertTable"></table></div>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h3 class="h6 fw-bold mb-0">Most recent violations</h3>
          <span class="note">Last 5 logged — full history under Violation Log</span>
        </div>
        <div class="table-responsive"><table class="table table-hover mb-0" id="overviewViolTable"></table></div>
      </div>
    </div>
  </section>

  <!-- ROSTER -->
  <section class="view" id="view-roster">
    <div class="mb-3">
      <div class="eyebrow">People</div>
      <h2 class="mt-1 mb-1">Traders &amp; Tiers</h2>
      <p class="text-secondary small" style="max-width:640px;">The roster every other tab reads from. Tier drives risk limits and profit split — Master Plan §7.1.</p>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive"><table class="table table-hover align-middle mb-2" id="rosterTable"></table></div>
        <button class="btn btn-e1 btn-sm" id="addTraderBtn"><i class="bi bi-plus-lg"></i> Add trader</button>
      </div>
    </div>
  </section>

  <!-- DAILY -->
  <section class="view" id="view-daily">
    <div class="mb-3">
      <div class="eyebrow">People</div>
      <h2 class="mt-1 mb-1">Daily Risk Board</h2>
      <p class="text-secondary small" style="max-width:640px;">Status badges apply the circuit breakers from Risk Protocol §3 and §6 automatically.</p>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive"><table class="table table-hover align-middle mb-2" id="dailyTable"></table></div>
        <div class="note">Thresholds: daily −2% warns, −3% is a hard stop for the day · weekly −5% triggers review, −7% pauses the account · monthly −8% moves the trader to simulation mode · 2 losses in a row forces a 30-min break, 3 ends trading for the day.</div>
      </div>
    </div>
  </section>

  <!-- KPI -->
  <section class="view" id="view-kpi">
    <div class="mb-3">
      <div class="eyebrow">People</div>
      <h2 class="mt-1 mb-1">KPI Scorecard</h2>
      <p class="text-secondary small" style="max-width:640px;">Reviewed monthly against Master Plan §7.3 — what a tier promotion or demotion is measured against.</p>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive"><table class="table table-hover align-middle mb-2" id="kpiTable"></table></div>
        <div class="note">Targets: avg R-multiple ≥1.5R · rolling 30-day drawdown under 5% · 0 rule violations in the last 90 days.</div>
      </div>
    </div>
  </section>

  <!-- VIOLATIONS -->
  <section class="view" id="view-violations">
    <div class="mb-3">
      <div class="eyebrow">People</div>
      <h2 class="mt-1 mb-1">Violation Log</h2>
      <p class="text-secondary small" style="max-width:640px;">Maps to the four-level ladder in Risk Protocol §8. Level 3 demotes a tier; Level 4 escalates to the MD and Compliance Liaison.</p>
    </div>
    <div class="card mb-3">
      <div class="card-body">
        <h3 class="h6 fw-bold">Log a new violation</h3>
        <div class="table-responsive"><table class="table mb-2" id="violationForm"></table></div>
        <button class="btn btn-e1 btn-sm" id="addViolationBtn"><i class="bi bi-plus-lg"></i> Log violation</button>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <h3 class="h6 fw-bold">Full history</h3>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0" id="violationTable"></table></div>
      </div>
    </div>
  </section>

  <!-- FUNDED ACCOUNTS -->
  <section class="view" id="view-funded">
    <div class="mb-3">
      <div class="eyebrow">Capital — Prop Firms</div>
      <h2 class="mt-1 mb-1">Funded Accounts</h2>
      <p class="text-secondary small" style="max-width:720px;">Every prop-firm evaluation or funded account, across every firm — a trader can hold more than one (§3.1's two-account approach). <b>Est. Payout</b> runs each account's live profit through the full waterfall in Master Plan §7.2 — prop firm's cut, Compliance Reserve, role overrides, then the trader's tier split — so it's what that trader would actually be paid today, not the raw account P&amp;L.</p>
    </div>
    <div id="fundedBanner"></div>
    <div class="row g-3 mb-2" id="fundedStatGrid"></div>
    <div class="card mt-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h3 class="h6 fw-bold mb-0">Accounts</h3>
          <span class="note">One row per account, not per trader</span>
        </div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-2" id="fundedTable"></table></div>
        <button class="btn btn-e1 btn-sm" id="addFundedBtn"><i class="bi bi-plus-lg"></i> Add funded account</button>
        <div class="note mt-2">Firm daily/max loss limits and payout split are the firm's own published terms (reference only, re-verify against their current rulebook) — Empire One's internal stop is always tighter and trips first by design (Risk Protocol §3).</div>
      </div>
    </div>
  </section>

  <!-- LIVE -->
  <section class="view" id="view-live">
    <div class="mb-3">
      <div class="eyebrow">Capital — Pooled Capital</div>
      <h2 class="mt-1 mb-1">Live Accounts</h2>
      <p class="text-secondary small" style="max-width:720px;">Individual sub-accounts funded from pooled seed capital (§4.2–§4.3). <b>Est. Payout</b> applies the same waterfall as funded accounts, minus the prop-firm cut layer — live capital has no firm taking a share first.</p>
    </div>
    <div id="liveBanner"></div>
    <div class="row g-3 mb-2" id="liveStatGrid"></div>
    <div class="card mt-3">
      <div class="card-body">
        <div class="table-responsive"><table class="table table-hover align-middle mb-2" id="liveTable"></table></div>
        <button class="btn btn-e1 btn-sm" id="addLiveBtn"><i class="bi bi-plus-lg"></i> Add live account</button>
      </div>
    </div>
  </section>

  <!-- EXPOSURE -->
  <section class="view" id="view-exposure">
    <div class="mb-3">
      <div class="eyebrow">Capital — Pooled Capital</div>
      <h2 class="mt-1 mb-1">Correlation &amp; Exposure Sheet</h2>
      <p class="text-secondary small" style="max-width:640px;">Positions grouped by instrument and direction — if a group crosses 40% of group capital, that's the correlation cap in Risk Protocol §4.</p>
    </div>
    <div id="exposureBanner"></div>
    <div class="card mb-3">
      <div class="card-body">
        <h3 class="h6 fw-bold">Open positions</h3>
        <div class="table-responsive"><table class="table table-hover align-middle mb-2" id="exposureTable"></table></div>
        <button class="btn btn-e1 btn-sm" id="addExposureBtn"><i class="bi bi-plus-lg"></i> Add position</button>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <h3 class="h6 fw-bold">Grouped exposure by instrument &amp; direction</h3>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0" id="exposureGroupTable"></table></div>
      </div>
    </div>
  </section>

  <!-- INVESTORS -->
  <section class="view" id="view-investors">
    <div class="mb-3">
      <div class="eyebrow">Capital — Investors</div>
      <h2 class="mt-1 mb-1">Investor Accounts</h2>
      <p class="text-secondary small" style="max-width:760px;">Tracks each outside investor's segregated sub-account (Master Plan §8.5, Investor Agreement §2) — separate from Funded and Live accounts because the fee mechanic is different: a <b>performance fee owed to Empire One</b>, charged only on new profit above the investor's high-water mark, not a trader profit split.</p>
    </div>
    <div id="investorsBanner"></div>
    <div class="row g-3 mb-2" id="investorsStatGrid"></div>
    <div class="card mt-3">
      <div class="card-body">
