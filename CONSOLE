  /* ============ RENDER: REMITTANCE TRACKER ============ */
  function renderRemittance(){
    var rows = [];
    fundedAccounts.forEach(function(a){
      var earn = fundedEarnings(a);
      var owed = amountOwed(earn);
      if(owed <= 0) return;
      var rec = getRemitRecord('funded', a.id);
      var due = dueDateFor('funded', rec);
      var st = remittanceStatus(rec, due, owed);
      if(!st) return;
      var t = trader(a.traderId);
      rows.push({ rec:rec, st:st, due:due, owed:owed, traderName: t?t.name:"—", label: a.firm+" ("+a.phase+")", accountType:'funded' });
    });
    liveAccounts.forEach(function(a){
      var earn = liveEarnings(a);
      var owed = amountOwed(earn);
      if(owed <= 0) return;
      var rec = getRemitRecord('live', a.id);
      var due = dueDateFor('live', rec);
      var st = remittanceStatus(rec, due, owed);
      if(!st) return;
      var t = trader(a.traderId);
      rows.push({ rec:rec, st:st, due:due, owed:owed, traderName: t?t.name:"—", label: a.label, accountType:'live' });
    });

    var overdue = rows.filter(function(r){ return r.st.cls==='bad'; });
    var dueSoon = rows.filter(function(r){ return r.st.label==='Due Soon' || r.st.label==='Level 1 Late'; });
    var totalOwed = rows.filter(function(r){ return r.st.label!=='Complete'; }).reduce(function(s,r){ return s+r.owed; },0);
    var complete = rows.filter(function(r){ return r.st.label==='Complete'; }).length;

    document.getElementById('remittanceStatGrid').innerHTML =
      stat("Outstanding remittances", rows.length - complete, "accounts still owed", (rows.length-complete)>0?"neutral":"ok") +
      stat("Overdue / short", overdue.length, "Level 2+ or short — CRO should suspend", overdue.length>0?"bad":"ok") +
      stat("Due soon / Level 1", dueSoon.length, "within 2 days or 1-3 days late", dueSoon.length>0?"warn":"ok") +
      stat("Total outstanding", money(totalOwed), "not yet fully remitted", totalOwed>0?"warn":"ok");

    document.getElementById('remittanceBanner').innerHTML = overdue.length
      ? bannerHtml('bad', overdue.length+' remittance(s) at Level 2 or worse.', 'Per Master Plan §10.4, trading access on these accounts should be suspended until resolved — log the corresponding entry in the Violation Log if not already done.')
      : (rows.length ? bannerHtml('ok','No remittances are currently overdue.','Everything owed is either complete or still within its due window.') : '');

    var el = document.getElementById('remittanceTable');
    if(rows.length===0){
      el.innerHTML = '<tbody><tr class="empty-row"><td colspan="8">No outstanding remittances \u2014 either nothing owed yet, or everything has been forwarded.</td></tr></tbody>';
    } else {
      rows.sort(function(a,b){ return a.due - b.due; });
      var head = '<thead><tr><th>Trader</th><th>Account</th><th>Amount Owed</th>'+
        '<th>'+'Payout / Trigger Date'+'</th><th>Due</th><th>Remitted</th><th>Method / Ref</th><th>Status</th></tr></thead>';
      var body = rows.map(function(r){
        var payoutCell = r.accountType==='funded'
          ? '<input type="date" class="form-control form-control-sm" style="max-width:140px;" value="'+r.rec.payoutDate+'" data-remitfield="payoutDate" data-id="'+r.rec.id+'">'
          : '<span class="note">Weekly (Fri)</span>';
        var remittedCell = '<div class="form-check mb-1"><input class="form-check-input" type="checkbox" data-remitfield="remitted" data-id="'+r.rec.id+'" '+(r.rec.remitted?'checked':'')+'></div>' +
          (r.rec.remitted ? '<input type="number" class="form-control form-control-sm" style="max-width:100px;" step="1" value="'+r.rec.remittedAmount+'" placeholder="Amount" data-remitfield="remittedAmount" data-id="'+r.rec.id+'">' : '');
        var refCell = r.rec.remitted
          ? '<input type="text" class="form-control form-control-sm mb-1" style="max-width:140px;" placeholder="Bank/Wise ref" value="'+attr(r.rec.reference)+'" data-remitfield="reference" data-id="'+r.rec.id+'">'
          : '<span class="note">—</span>';
        return '<tr>'+
          '<td>'+esc(r.traderName)+'</td>'+
          '<td>'+esc(r.label)+'</td>'+
          '<td class="mono fw-semibold">'+money(r.owed)+'</td>'+
          '<td>'+payoutCell+'</td>'+
          '<td class="note">'+fmtDate(r.due)+'</td>'+
          '<td>'+remittedCell+'</td>'+
          '<td>'+refCell+'</td>'+
          '<td>'+badge(r.st)+'</td>'+
          '</tr>';
      }).join('');
      el.innerHTML = head + '<tbody>' + body + '</tbody>';
    }

    el.querySelectorAll('[data-remitfield]').forEach(function(input){
      input.addEventListener('change', function(){
        var rec = remittances.find(function(r){ return r.id === input.getAttribute('data-id'); });
        if(!rec) return;
        var f = input.getAttribute('data-remitfield');
        if(f==='remitted'){
          rec.remitted = input.checked;
          if(rec.remitted && !rec.remittedDate) rec.remittedDate = todayISO();
        } else if(f==='remittedAmount'){
          rec.remittedAmount = parseFloat(input.value)||0;
        } else {
          rec[f] = input.value;
        }
        saveRemittances(); renderAll();
      });
    });
  }

  /* ============ DIVIDEND DECLARATION ENGINE ============ */
  // Master Plan §7.2 Layer 5/6, §10.5: the Day 20 pool is whatever's left in reinvestmentPool
  // across every account after Layer 6 (Dev/Ops Reserve) is carved out — this is the ONLY
  // amount a dividend can be declared from, never the trader's own share.
  function dividendPool(){
    return fundedAccounts.reduce(function(s,a){ return s + fundedEarnings(a).reinvestmentPool; },0)
         + liveAccounts.reduce(function(s,a){ return s + liveEarnings(a).reinvestmentPool; },0);
  }
  function dividendSplits(pool){
    var weighted = roster.map(function(t){ return { trader:t, w: equityWeight(t.contribution).weight }; });
    var totalWeight = weighted.reduce(function(s,x){ return s+x.w; }, 0);
    if(totalWeight<=0) return [];
    return weighted.map(function(x){
      return { traderId:x.trader.id, name:x.trader.name, bracket:equityWeight(x.trader.contribution).bracket,
        weight:x.w, amount: pool * (x.w/totalWeight) };
    });
  }
  function renderDividend(){
    var pool = dividendPool();
    var votesInput = document.getElementById('divVotesFor');
    var votes = votesInput ? (parseInt(votesInput.value,10)||0) : 0;
    var approved = votes >= 6;

    document.getElementById('dividendStatGrid').innerHTML =
      stat("Day 20 pool available", money(pool), "post-Layer-6 reinvestment, §7.2/§10", "neutral") +
      stat("Active Members", roster.length, "voting base for §8 threshold", "neutral") +
      stat("Vote threshold", "6 of 10", "Member Agreement §8", "neutral") +
      stat("Declarations logged", dividendLog.length, "all-time", "neutral");

    var statusEl = document.getElementById('divVoteStatus');
    statusEl.innerHTML = votes>0
      ? badge({label: approved ? "Approved — "+votes+"/10" : "Not approved — "+votes+"/10 (needs 6)", cls: approved?"ok":"bad"})
      : '<span class="note">Enter the vote count from the Day 20 meeting</span>';

    var splits = dividendSplits(pool);
    var splitEl = document.getElementById('dividendSplitTable');
    var head = '<thead><tr><th>Member</th><th>Bracket</th><th>Weight</th><th>Proposed Share</th></tr></thead>';
    var rows = splits.map(function(s){
      return '<tr><td>'+esc(s.name)+'</td><td>'+esc(s.bracket)+'</td><td class="mono">'+s.weight+'x</td><td class="mono fw-semibold">'+money(s.amount)+'</td></tr>';
    }).join('');
    splitEl.innerHTML = head + '<tbody>' + (rows || emptyRow(4,"Add traders with contribution amounts on Traders & Tiers first.")) + '</tbody>';

    var declareBtn = document.getElementById('declareDividendBtn');
    declareBtn.disabled = !(approved && pool>0 && splits.length>0);

    var histEl = document.getElementById('dividendHistoryTable');
    var histHead = '<thead><tr><th>Date</th><th>Total Declared</th><th>Votes</th><th>Recipients</th></tr></thead>';
    var sorted = dividendLog.slice().sort(function(a,b){ return new Date(b.date)-new Date(a.date); });
    var histRows = sorted.map(function(d){
      return '<tr><td>'+esc(d.date)+'</td><td class="mono fw-semibold">'+money(d.total)+'</td><td>'+d.votesFor+'/10</td><td>'+d.splits.length+'</td></tr>';
    }).join('');
    histEl.innerHTML = histHead + '<tbody>' + (histRows || emptyRow(4,"No dividends declared yet.")) + '</tbody>';
  }
  document.getElementById('divVotesFor').addEventListener('change', function(){ renderDividend(); });
  document.getElementById('divVotesFor').addEventListener('input', function(){ renderDividend(); });
  document.getElementById('declareDividendBtn').addEventListener('click', function(){
    var pool = dividendPool();
    var votes = parseInt(document.getElementById('divVotesFor').value,10)||0;
    if(votes<6 || pool<=0) return;
    var splits = dividendSplits(pool);
    dividendLog.push({ id: uid(), date: todayISO(), total: pool, votesFor: votes, splits: splits });
    saveDividendLog();
    document.getElementById('divVotesFor').value = '0';
    renderAll();
  });

