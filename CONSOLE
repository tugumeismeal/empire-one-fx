  function groupExposure(){
    var map = {};
    exposureSheet.forEach(function(x){
      var key = (x.instrument||'—') + ' · ' + x.direction;
      map[key] = (map[key]||0) + (Number(x.sizePct)||0);
    });
    return Object.keys(map).map(function(k){ return {key:k, pct:map[k]}; }).sort(function(a,b){ return b.pct-a.pct; });
  }
