<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<script>
(function(){

  /* ============ CONSTANTS ============ */
  var TIERS = ["Probationary","Standard","Senior","Lead"];

  // Every money-related number the app calculates from lives in DEFAULT_SETTINGS below.
  // The working copy ("settings") is loaded from storage if the group has customized it,
  // otherwise falls back to these defaults — edit them on the Settings page, not in code.
  var DEFAULT_SETTINGS = {
    thresholds: { dailyWarn:-2, dailyStop:-3, weeklyReview:-5, weeklyPause:-7, monthlySim:-8, liveDDPause:15, exposureCap:40 },
    propSplit: { Probationary:50, Standard:60, Senior:70, Lead:75 },
    liveSplit: { Probationary:0, Standard:55, Senior:60, Lead:65 }, // 0 = not eligible for live capital
    waterfall: { complianceReservePct:5, croPct:2, opsPct:2, analystPct:1, devOpsPct:50 },
    firmPresets: {
      "FTMO": {dailyLimit:5, maxLimit:10, payoutSplit:80},
      "FundedNext": {dailyLimit:5, maxLimit:10, payoutSplit:90},
      "The5ers": {dailyLimit:0, maxLimit:6, payoutSplit:50},
      "Alpha Capital Group": {dailyLimit:5, maxLimit:10, payoutSplit:90},
      "DNA Funded": {dailyLimit:5, maxLimit:10, payoutSplit:85},
      "Custom": {dailyLimit:5, maxLimit:10, payoutSplit:80}
    },
    investorDefaults: { minContribution:5000, lockupDays:90, performanceFeePct:15 },
    maxTradesPerDay: 5,
    newsBlackoutMin: 15
  };
  function cloneDefaults(){ return JSON.parse(JSON.stringify(DEFAULT_SETTINGS)); }
  var settings = cloneDefaults();
  function roleOverridePct(){ return (Number(settings.waterfall.croPct)||0) + (Number(settings.waterfall.opsPct)||0) + (Number(settings.waterfall.analystPct)||0); }

  var VIOL_LEVELS = [
    {v:1,label:"Level 1 — Warning"},
    {v:2,label:"Level 2 — Suspension"},
    {v:3,label:"Level 3 — Demotion"},
    {v:4,label:"Level 4 — Removal"}
  ];
  var WORKFLOW_DAYS = [
    {key:"d1",day:"Day 1",title:"Prop firm withdrawal requests",desc:"Traders submit withdrawal requests to their funded prop firms."},
    {key:"d5",day:"Day 5–10",title:"Fund consolidation",desc:"Funds arrive in the Empire One Master Wallet."},
    {key:"d12",day:"Day 12",title:"Audit & verification",desc:"Ops Manager verifies P&L against broker and live sub-account statements."},
    {key:"d15",day:"Day 15",title:"Profit distribution",desc:"Waterfall applied — trader shares and entity reinvestment paid out."},
    {key:"d18",day:"Day 18",title:"Compliance reserve logged",desc:"Compliance & Legal Reserve allocation recorded; Development & Operating Reserve (Layer 6) carved out automatically from entity reinvestment."},
    {key:"d20",day:"Day 20",title:"Reinvestment meeting",desc:"Decides only the post-Layer-6 pool: new challenges vs. live-account scaling vs. dividends."},
    {key:"d25",day:"Day 25",title:"Education revenue distributed",desc:"Signals/Academy revenue allocated or routed to marketing."}
  ];
  function buildRefRows(){
    var t = settings.thresholds;
    return [
      ["Max risk / trade (Standard tier)","0.5%–1.0%"],
      ["Daily hard stop", t.dailyStop+"% → halted for the day"],
      ["Weekly pause threshold", t.weeklyPause+"% → halted until CRO + MD review"],
      ["Monthly simulation-mode threshold", t.monthlySim+"%"],
      ["Losses before mandatory break","2 → 30-min break · 3 → done for day"],
      ["Max trades per day", String(settings.maxTradesPerDay)],
      ["News blackout window", settings.newsBlackoutMin+" min before/after tier-1 releases"],
      ["Stop-loss policy","Set at entry, always — tighten only, never widen"],
      ["Group correlation cap", t.exposureCap+"% of capital, one direction"],
      ["Live account drawdown pause", "−"+t.liveDDPause+"% from high-water mark"]
    ];
  }
  var FUNDED_PHASES = ["Phase 1","Phase 2","Funded"];
  var PHASE_TARGET_DEFAULT = { "Phase 1":10, "Phase 2":5, "Funded":0 };

  /* ============ STATE ============ */
  var roster = [];
  var fundedAccounts = [];
  var liveAccounts = [];
  var investors = [];
  var remittances = [];
  var dividendLog = [];
  var violationLog = [];
  var exposureSheet = [];
  var workflow = { month: currentMonthLabel(), checks:{} };

  function currentMonthLabel(){
    var d = new Date();
    return d.toLocaleString('en-US',{month:'long',year:'numeric'});
  }
  function uid(){ return Math.random().toString(36).slice(2,10); }

  /* ============ STORAGE ============ */
  function markSaving(){ document.getElementById('saveState').textContent = '● saving…'; }
  function markSaved(){ document.getElementById('saveState').textContent = '● all changes saved locally'; }
  function markError(){ document.getElementById('saveState').textContent = '⚠ save failed — retry'; }

  async function saveRoster(){
    markSaving();
    try{ await window.storage.set('roster', JSON.stringify(roster), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveFunded(){
    markSaving();
    try{ await window.storage.set('fundedAccounts', JSON.stringify(fundedAccounts), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveLive(){
    markSaving();
    try{ await window.storage.set('liveAccounts', JSON.stringify(liveAccounts), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveInvestors(){
    markSaving();
    try{ await window.storage.set('investors', JSON.stringify(investors), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveRemittances(){
    markSaving();
    try{ await window.storage.set('remittances', JSON.stringify(remittances), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveDividendLog(){
    markSaving();
    try{ await window.storage.set('dividendLog', JSON.stringify(dividendLog), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveSettings(){
    markSaving();
    try{ await window.storage.set('settings', JSON.stringify(settings), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveViolations(){
    markSaving();
    try{ await window.storage.set('violationLog', JSON.stringify(violationLog), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveExposure(){
    markSaving();
    try{ await window.storage.set('exposureSheet', JSON.stringify(exposureSheet), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }
  async function saveWorkflow(){
    markSaving();
    try{ await window.storage.set('workflow', JSON.stringify(workflow), false); markSaved(); }
    catch(e){ console.error(e); markError(); }
  }

  async function loadAll(){
    try{
      var s = await window.storage.get('settings', false);
      if(s){
        var loaded = JSON.parse(s.value);
        // Merge over defaults so a settings blob saved before a new field existed
        // (e.g. an older version without newsBlackoutMin) doesn't leave it undefined.
        // firmPresets is the one exception: it's a user-managed list (add/delete), so it's
        // taken as-is rather than merged — otherwise a deleted firm would silently reappear
        // on every reload because "missing from saved data" would be read as "add it back".
        settings = cloneDefaults();
        Object.keys(loaded).forEach(function(k){
          if(k === 'firmPresets'){
            settings.firmPresets = loaded.firmPresets;
          } else if(typeof loaded[k]==='object' && loaded[k]!==null && !Array.isArray(loaded[k])){
            settings[k] = Object.assign({}, settings[k], loaded[k]);
          } else {
            settings[k] = loaded[k];
          }
        });
        // Safety net: "Custom" is the one preset the UI won't let you delete, but guard
        // against it being missing anyway (e.g. hand-edited storage) so lookups never break.
        if(!settings.firmPresets || !settings.firmPresets["Custom"]){
          settings.firmPresets = settings.firmPresets || {};
          settings.firmPresets["Custom"] = cloneDefaults().firmPresets["Custom"];
        }
      }
    }catch(e){ settings = cloneDefaults(); }

    try{
      var r = await window.storage.get('roster', false);
      roster = r ? JSON.parse(r.value) : defaultRoster();
    }catch(e){ roster = defaultRoster(); }

    try{
      var fa = await window.storage.get('fundedAccounts', false);
      fundedAccounts = fa ? JSON.parse(fa.value) : [];
    }catch(e){ fundedAccounts = []; }

    try{
      var la = await window.storage.get('liveAccounts', false);
      liveAccounts = la ? JSON.parse(la.value) : [];
    }catch(e){ liveAccounts = []; }

    try{
      var iv = await window.storage.get('investors', false);
      investors = iv ? JSON.parse(iv.value) : [];
    }catch(e){ investors = []; }

    try{
      var rm = await window.storage.get('remittances', false);
      remittances = rm ? JSON.parse(rm.value) : [];
    }catch(e){ remittances = []; }

    try{
      var dv = await window.storage.get('dividendLog', false);
      dividendLog = dv ? JSON.parse(dv.value) : [];
    }catch(e){ dividendLog = []; }

    // Migration: pre-v3 versions stored one live balance/HWM per trader on the roster row itself.
    var migrated = false;
    roster.forEach(function(t){
      if((t.liveBalance || t.liveHWM) && !t._migratedLive){
        liveAccounts.push({
          id: uid(), traderId: t.id, label:"Migrated account",
          balance: Number(t.liveBalance)||0, hwm: Number(t.liveHWM)||0,
          seed: Number(t.liveHWM)||Number(t.liveBalance)||0, notes:""
        });
        t._migratedLive = true;
        migrated = true;
      }
    });
    if(migrated){ saveRoster(); saveLive(); }
    // Backfill "seed" for any live accounts created before that field existed
    liveAccounts.forEach(function(a){ if(a.seed===undefined || a.seed===null) a.seed = a.hwm || a.balance || 0; });
    fundedAccounts.forEach(function(a){ if(a.payoutSplitPct===undefined) a.payoutSplitPct = (settings.firmPresets[a.firm]||settings.firmPresets.Custom).payoutSplit; });
    roster.forEach(function(t){ if(t.contribution===undefined) t.contribution = 100; });


    try{
      var v = await window.storage.get('violationLog', false);
      violationLog = v ? JSON.parse(v.value) : [];
    }catch(e){ violationLog = []; }

    try{
      var x = await window.storage.get('exposureSheet', false);
      exposureSheet = x ? JSON.parse(x.value) : [];
    }catch(e){ exposureSheet = []; }

    try{
      var w = await window.storage.get('workflow', false);
      workflow = w ? JSON.parse(w.value) : { month: currentMonthLabel(), checks:{} };
    }catch(e){ workflow = { month: currentMonthLabel(), checks:{} }; }

    renderAll();
  }

  function defaultRoster(){
    return [ mkTrader("Trader 1","Standard"), mkTrader("Trader 2","Probationary") ];
  }
  function mkTrader(name,tier){
    return {
      id: uid(), name:name, tier: tier||"Probationary", status:"Active", notes:"",
      dailyPnL:0, weeklyPnL:0, monthlyPnL:0, openPositions:0, consecLosses:0,
      winRate:0, avgR:0, dd30:0, viol90:0,
      contribution:100 // cumulative capital contribution, Master Plan §2.4 — drives equity weight
    };
  }
  function equityWeight(contribution){
    var c = Number(contribution)||0;
    if(c >= 1000) return {bracket:"Sponsor", weight:2};
    if(c >= 500) return {bracket:"Enhanced", weight:1.5};
    return {bracket:"Baseline", weight:1};
  }
  function mkFunded(traderId){
    var p = settings.firmPresets["FTMO"];
    return {
      id: uid(), traderId:traderId, firm:"FTMO", accountSize:10000, phase:"Phase 1",
      balance:10000, profitTargetPct: PHASE_TARGET_DEFAULT["Phase 1"],
      dailyLossUsedPct:0, maxLossUsedPct:0,
      firmDailyLimitPct:p.dailyLimit, firmMaxLimitPct:p.maxLimit, payoutSplitPct:p.payoutSplit
    };
  }
  function mkLive(traderId){
    return { id: uid(), traderId:traderId, label:"Live account", balance:100, hwm:100, seed:100, notes:"" };
  }
  function mkInvestor(){
    var d = settings.investorDefaults;
    return {
      id: uid(), name:"New investor", contribution:d.minContribution, balance:d.minContribution, hwm:d.minContribution,
      fundedDate: todayISO(), lockupDays:d.lockupDays, performanceFeePct:d.performanceFeePct, notes:""
    };
  }

  /* ============ NAV ============ */
  var navLinks = Array.prototype.slice.call(document.querySelectorAll('#navList .nav-link'));
  navLinks.forEach(function(link){
    link.addEventListener('click', function(e){
      e.preventDefault();
      var target = link.getAttribute('data-view');
      navLinks.forEach(function(l){ l.classList.remove('active'); });
      link.classList.add('active');
      document.querySelectorAll('.view').forEach(function(v){ v.classList.remove('active'); });
      document.getElementById('view-' + target).classList.add('active');
      
      // Re-render charts when overview tab is activated
      if (target === 'overview') {
        setTimeout(renderCharts, 100);
      }
    });
  });
  navLinks[0].classList.add('active');

  /* ============ STATUS HELPERS ============ */
  function dailyStatus(t){
    if(t.dailyPnL <= settings.thresholds.dailyStop) return {label:"HARD STOP", cls:"bad"};
    if(t.dailyPnL <= settings.thresholds.dailyWarn) return {label:"Warning", cls:"warn"};
    return {label:"Normal", cls:"ok"};
  }
  function weeklyStatus(t){
    if(t.weeklyPnL <= settings.thresholds.weeklyPause) return {label:"Paused", cls:"bad"};
    if(t.weeklyPnL <= settings.thresholds.weeklyReview) return {label:"Review", cls:"warn"};
    return {label:"Normal", cls:"ok"};
  }
  function monthlyStatus(t){
    if(t.monthlyPnL <= settings.thresholds.monthlySim) return {label:"Simulation", cls:"bad"};
    return {label:"Normal", cls:"ok"};
  }
  function streakStatus(t){
    if(t.consecLosses >= 3) return {label:"Done for day", cls:"bad"};
    if(t.consecLosses === 2) return {label:"30-min break", cls:"warn"};
    return {label:"Clear", cls:"ok"};
  }
  function liveDD(acc){
    if(!acc.hwm || acc.hwm <= 0) return 0;
    var dd = (acc.hwm - acc.balance) / acc.hwm * 100;
    return dd < 0 ? 0 : dd;
  }
  function liveStatus(acc){
    var dd = liveDD(acc);
    if(dd >= settings.thresholds.liveDDPause) return {label:"PAUSED", cls:"bad", dd:dd};
    if(dd >= settings.thresholds.liveDDPause*0.66) return {label:"Watch", cls:"warn", dd:dd};
    return {label:"Normal", cls:"ok", dd:dd};
  }
  function fundedProgressPct(a){
    if(!a.profitTargetPct || a.profitTargetPct<=0) return null;
    var targetGain = a.accountSize * (a.profitTargetPct/100);
    if(targetGain<=0) return null;
    var gain = a.balance - a.accountSize;
    return Math.max(0, Math.min(150, (gain/targetGain)*100));
  }
  function fundedStatus(a){
    if(a.dailyLossUsedPct >= settings.thresholds.dailyStop*-1 || a.maxLossUsedPct >= (a.firmMaxLimitPct||10))
      return {label:"BREACHED", cls:"bad"};
    if(a.dailyLossUsedPct >= settings.thresholds.dailyWarn*-1 || a.maxLossUsedPct >= (a.firmMaxLimitPct||10)*0.7)
      return {label:"At Risk", cls:"warn"};
    var prog = fundedProgressPct(a);
    if(a.phase === "Funded") return {label:"Funded — Active", cls:"ok"};
    if(prog !== null && prog >= 100) return {label:"Target Reached", cls:"ok"};
    if(prog !== null && prog >= 75) return {label:"Approaching Target", cls:"warn"};
    return {label:"On Track", cls:"ok"};
  }
  function fundedOf(traderId){ return fundedAccounts.filter(function(a){ return a.traderId===traderId; }); }
  function liveOf(traderId){ return liveAccounts.filter(function(a){ return a.traderId===traderId; }); }
  function kpiFlags(t){
    var r = t.avgR >= 1.5 ? "ok" : (t.avgR >= 1 ? "warn" : "bad");
    var d = t.dd30 < 5 ? "ok" : (t.dd30 <= 8 ? "warn" : "bad");
    var v = t.viol90 === 0 ? "ok" : (t.viol90 === 1 ? "warn" : "bad");
    return {r:r,d:d,v:v};
  }
  function isAlert(t){
    var d = dailyStatus(t).cls !== 'ok';
    var w = weeklyStatus(t).cls !== 'ok';
    var m = monthlyStatus(t).cls !== 'ok';
    var s = streakStatus(t).cls !== 'ok';
    var l = liveOf(t.id).some(function(a){ return liveStatus(a).cls === 'bad'; });
    var f = fundedOf(t.id).some(function(a){ return fundedStatus(a).cls === 'bad'; });
    return d||w||m||l||s||f;
  }
  function badge(st){
    var map = {ok:'success', warn:'warning', bad:'danger', neutral:'secondary'};
    return '<span class="badge text-bg-'+(map[st.cls]||'secondary')+'">'+st.label+'</span>';
  }
  function trader(id){ for(var i=0;i<roster.length;i++){ if(roster[i].id===id) return roster[i]; } return null; }

  /* ============ EARNINGS ENGINE ============ */
  // Full waterfall from Master Plan §7.2. Funded accounts pass through the prop-firm cut
  // (Layer 1) first; live accounts skip straight to the Compliance Reserve (Layer 2) since
  // there's no prop firm taking a share of pooled seed capital.
  function fundedEarnings(a){
    var t = trader(a.traderId);
    var tier = t ? t.tier : "Probationary";
    var gross = Math.max(0, (Number(a.balance)||0) - (Number(a.accountSize)||0));
    var firmCutPct = 100 - (Number(a.payoutSplitPct)||80);
    var afterFirm = gross * ((Number(a.payoutSplitPct)||80)/100);
    var firmCut = gross - afterFirm;
    var compliance = afterFirm * (settings.waterfall.complianceReservePct/100);
    var afterCompliance = afterFirm - compliance;
    var overrides = afterCompliance * (roleOverridePct()/100);
    var afterOverrides = afterCompliance - overrides;
    var traderPct = settings.propSplit[tier] || 50;
    var traderShare = afterOverrides * (traderPct/100);
    var entityShare = afterOverrides - traderShare; // Layer 5, unchanged definition — full remainder
    var devOpsReserve = entityShare * ((Number(settings.waterfall.devOpsPct)||0)/100); // Layer 6
    var reinvestmentPool = entityShare - devOpsReserve; // what Day 20 actually decides on
    return { type:"Funded", tier:tier, traderPct:traderPct, gross:gross, firmCut:firmCut, firmCutPct:firmCutPct,
      compliance:compliance, overrides:overrides, traderShare:traderShare, entityShare:entityShare,
      devOpsReserve:devOpsReserve, reinvestmentPool:reinvestmentPool, eligible:true };
  }
  function liveEarnings(a){
    var t = trader(a.traderId);
    var tier = t ? t.tier : "Probationary";
    var seed = Number(a.seed)||Number(a.hwm)||0;
    var gross = Math.max(0, (Number(a.balance)||0) - seed);
    var traderPct = settings.liveSplit[tier];
    if(!traderPct){
      var devOps0 = gross * ((Number(settings.waterfall.devOpsPct)||0)/100);
      return { type:"Live", tier:tier, traderPct:0, gross:gross, compliance:0, overrides:0, traderShare:0,
        entityShare:gross, devOpsReserve:devOps0, reinvestmentPool:gross-devOps0, eligible:false };
    }
    var compliance = gross * (settings.waterfall.complianceReservePct/100);
    var afterCompliance = gross - compliance;
    var overrides = afterCompliance * (roleOverridePct()/100);
    var afterOverrides = afterCompliance - overrides;
    var traderShare = afterOverrides * (traderPct/100);
    var entityShare = afterOverrides - traderShare; // Layer 5
    var devOpsReserve = entityShare * ((Number(settings.waterfall.devOpsPct)||0)/100); // Layer 6
    var reinvestmentPool = entityShare - devOpsReserve;
    return { type:"Live", tier:tier, traderPct:traderPct, gross:gross, compliance:compliance,
      overrides:overrides, traderShare:traderShare, entityShare:entityShare,
      devOpsReserve:devOpsReserve, reinvestmentPool:reinvestmentPool, eligible:true };
  }
  function money(n){ return "$" + (Number(n)||0).toLocaleString('en-US',{maximumFractionDigits:0}); }
  function payoutCell(earn){
    var cls = earn.traderShare > 0 ? "pos" : "zero";
    return '<span class="payout-value '+cls+'">'+money(earn.traderShare)+'</span>';
  }

  // Investor performance fee — Investor Agreement §3: 0% management fee, performance fee
  // charged only on new profit above the investor's own high-water mark. This is revenue
  // TO Empire One, the mirror image of a trader payout, not a trader-facing number.
  function investorEarnings(inv){
    var newProfit = Math.max(0, (Number(inv.balance)||0) - (Number(inv.hwm)||0));
    var fee = newProfit * ((Number(inv.performanceFeePct)||0)/100);
    var netToInvestor = (Number(inv.balance)||0) - fee;
    return { newProfit:newProfit, fee:fee, netToInvestor:netToInvestor };
  }
  function lockupStatus(inv){
    var end = new Date(inv.fundedDate);
    end.setDate(end.getDate() + (Number(inv.lockupDays)||90));
    var now = new Date();
    var daysLeft = Math.ceil((end - now) / (1000*60*60*24));
    if(daysLeft > 14) return {label:"In lock-up", cls:"warn", daysLeft:daysLeft};
    if(daysLeft > 0) return {label:"Lock-up ending soon", cls:"warn", daysLeft:daysLeft};
    return {label:"Redemption eligible", cls:"ok", daysLeft:0};
  }
  function feeCell(fee){
    var cls = fee > 0 ? "pos" : "zero";
    return '<span class="payout-value '+cls+'">'+money(fee)+'</span>';
  }

  /* ============ REMITTANCE ENGINE ============ */
  // What a trader actually receives from the firm/broker is afterFirm (funded) or gross (live) —
  // everything except their own traderShare has to be forwarded to Ops. Master Plan §10.1–10.4.
  function amountOwed(earn){
    return Math.max(0, earn.compliance + earn.overrides + earn.entityShare);
  }
  function addDays(date, n){ var d = new Date(date); d.setDate(d.getDate()+n); return d; }
  function nextFriday(from){
    var d = new Date(from);
    var day = d.getDay(); // 0=Sun..6=Sat, Friday=5
    var diff = (5 - day + 7) % 7;
    d.setDate(d.getDate() + (diff===0 ? 7 : diff)); // if today IS Friday, due is the *upcoming* one
    return d;
  }
  function getRemitRecord(accountType, accountId){
    var rec = remittances.find(function(r){ return r.accountType===accountType && r.accountId===accountId; });
    if(!rec){
      rec = { id: uid(), accountType:accountType, accountId:accountId,
        payoutDate: todayISO(), remitted:false, remittedDate:"", remittedAmount:0, method:"", reference:"" };
      remittances.push(rec);
    }
    return rec;
  }
  function dueDateFor(accountType, rec){
    if(accountType==='funded'){ return addDays(rec.payoutDate, 3); }
    return nextFriday(new Date()); // live accounts: always the upcoming Friday, recurring
  }
  function remittanceStatus(rec, dueDate, owed){
    if(owed <= 0) return null; // nothing owed yet, don't show a status at all
    if(rec.remitted){
      if((Number(rec.remittedAmount)||0) + 0.01 < owed) return {label:"Short", cls:"bad"};
      return {label:"Complete", cls:"ok"};
    }
    var now = new Date();
    var daysLate = Math.floor((now - dueDate) / (1000*60*60*24));
    if(daysLate > 3) return {label:"Level 2+ Overdue", cls:"bad"};
    if(daysLate > 0) return {label:"Level 1 Late", cls:"warn"};
    if(dueDate - now <= 2*24*60*60*1000) return {label:"Due Soon", cls:"warn"};
    return {label:"On Track", cls:"neutral"};
  }
  function fmtDate(d){
    return d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
  }

  function openEarningsModal(accType, accId){
    if(accType==='investor'){
      var inv = investors.find(function(x){return x.id===accId;});
      if(!inv) return;
      var ie = investorEarnings(inv);
      var ls = lockupStatus(inv);
      document.getElementById('earningsModalTitle').textContent = inv.name + " — Investor Account";
      var ibody = '';
      ibody += row("Current balance", money(inv.balance), "As of last statement update");
      ibody += row("High-water mark", money(inv.hwm), "Highest balance previously reached — fees only apply above this");
      ibody += row("New profit above high-water mark", money(ie.newProfit), "Only this portion is fee-eligible — Investor Agreement §3");
      ibody += row("Performance fee ("+inv.performanceFeePct+"%, 0% management fee)", "−"+money(ie.fee), "Revenue to Empire One, not a trader payout — Investor Agreement §3");
      ibody += '<div class="waterfall-row final"><span class="k">Net value to '+esc(inv.name)+'</span><span class="v">'+money(ie.netToInvestor)+'</span></div>';
      ibody += '<div class="note mt-2">Lock-up status: '+ls.label+(ls.daysLeft>0?' ('+ls.daysLeft+' days remaining)':'')+' — Investor Agreement §5</div>';
      document.getElementById('earningsModalBody').innerHTML = ibody;
      showModal(inv.name + " — Investor Account");
      return;
    }
    var a, earn, t, label;
    if(accType==='funded'){
      a = fundedAccounts.find(function(x){return x.id===accId;});
      if(!a) return;
      earn = fundedEarnings(a);
      t = trader(a.traderId);
      label = (t?t.name:"—") + " — " + a.firm + " (" + a.phase + ")";
    } else {
      a = liveAccounts.find(function(x){return x.id===accId;});
      if(!a) return;
      earn = liveEarnings(a);
      t = trader(a.traderId);
      label = (t?t.name:"—") + " — " + a.label;
    }
    document.getElementById('earningsModalTitle').textContent = label;
    var rows = [];
    rows.push(row("Gross account profit", money(earn.gross), "Current balance minus " + (accType==='funded'?"account size":"seed capital")));
    if(accType==='funded'){
      rows.push(row("Layer 1 — Prop firm cut ("+earn.firmCutPct.toFixed(0)+"%)", "−"+money(earn.firmCut), "Retained by the firm — Master Plan §7.2, Layer 1"));
    }
    rows.push(row("Layer 2 — Compliance & Legal Reserve ("+settings.waterfall.complianceReservePct+"%)", "−"+money(earn.compliance), "Funds legal review & licensing — §7.2, Layer 2"));
    rows.push(row("Layer 3 — Role overrides ("+roleOverridePct()+"%)", "−"+money(earn.overrides), "CRO "+settings.waterfall.croPct+"% + Ops "+settings.waterfall.opsPct+"% + Analyst "+settings.waterfall.analystPct+"% — §7.2, Layer 3"));
    var body = rows.join('');
    if(!earn.eligible){
      body += '<div class="alert alert-warning mt-3 mb-0 py-2 px-3" style="font-size:13px;">Probationary tier is not eligible for live-capital profit share (Master Plan §7.1) — 100% of this account\'s profit routes to entity reinvestment until this trader reaches Standard tier.</div>';
      body += row("Layer 5 — Entity reinvestment (remainder)", money(earn.entityShare), "100% of gross, since no trader share applies here — §7.2, Layer 5");
      body += row("Layer 6 — Development & Operating Reserve ("+settings.waterfall.devOpsPct+"% of Layer 5)", "−"+money(earn.devOpsReserve), "Carved out automatically before Day 20 — §7.2, Layer 6");
      body += '<div class="waterfall-row final"><span class="k">Available for the Day 20 decision</span><span class="v">'+money(earn.reinvestmentPool)+'</span></div>';
    } else {
      body += '<div class="waterfall-row final"><span class="k">'+ (t?t.name:"Trader") +' receives ('+earn.traderPct+'%, '+earn.tier+' tier)</span><span class="v">'+money(earn.traderShare)+'</span></div>';
      body += '<div class="note mt-3 mb-1" style="border-top:1px dashed var(--e1-line);padding-top:10px;">What happens to the rest — not the trader\'s money, tracked for transparency:</div>';
      body += row("Layer 5 — Entity reinvestment (remainder, unchanged definition)", money(earn.entityShare), "§7.2, Layer 5");
      body += row("Layer 6 — Development & Operating Reserve ("+settings.waterfall.devOpsPct+"% of Layer 5)", "−"+money(earn.devOpsReserve), "Carved out automatically before Day 20, no vote needed — §7.2, Layer 6");
      body += '<div class="note mt-1">Available for the Day 20 reinvestment decision: '+money(earn.reinvestmentPool)+'</div>';
    }
    document.getElementById('earningsModalBody').innerHTML = body;
    showModal(label);
  }
